{
  "name": "digitopub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "prisma generate && node -e \"if(process.env.DATABASE_URL){const{execSync}=require('child_process');console.log('Running migrations...');try{execSync('prisma migrate deploy',{stdio:'inherit'})}catch(e){console.log('Migration failed, attempting to resolve 0_init...');try{execSync('prisma migrate resolve --applied 0_init',{stdio:'inherit'});execSync('prisma migrate deploy',{stdio:'inherit'})}catch(err){console.error('Failed to resolve database migration.');process.exit(1)}}}else{console.log('Skipping migrations (no DATABASE_URL)')}\" && next build --webpack",
    "dev": "next dev",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "mysql -u $DATABASE_USER -p$DATABASE_PASSWORD $DATABASE_NAME < scripts/001_create_tables.sql",
    "db:seed": "mysql -u $DATABASE_USER -p$DATABASE_PASSWORD $DATABASE_NAME < scripts/002_insert_sample_data.sql",
    "ojs:sync": "bun run scripts/ojs-sync-cron.ts",
    "prisma:generate": "prisma generate",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
